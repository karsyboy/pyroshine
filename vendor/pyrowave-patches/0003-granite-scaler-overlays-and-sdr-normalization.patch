From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: karsyboy <karsyboy@k-ops.cloud>
Date: Tue, 27 Oct 2026 11:32:14 -0400
Subject: [PATCH 3/7] granite: maintained scaler patches for overlays and SDR
 output

checkout_granite.sh applies two Granite changes on top of the pinned
commit, in order:

- granite-sdr-normalization.patch: PQ input converted for SDR output is
  normalized to SDR reference white instead of being left in nits.
- granite-scaler-overlay.patch: up to two premultiplied RGBA layers are
  composited 1:1 over the input before any transfer function, for late
  cursor and notification composition.

shaders/slangmosh_scaler.hpp is regenerated from the patched scaler.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 checkout_granite.sh                     |   13 +
 patches/granite-scaler-overlay.patch    |  164 ++++
 patches/granite-sdr-normalization.patch |   14 +
 shaders/slangmosh_scaler.hpp            | 1092 ++++++++++++-----------
 4 files changed, 776 insertions(+), 507 deletions(-)
 create mode 100644 patches/granite-scaler-overlay.patch
 create mode 100644 patches/granite-sdr-normalization.patch

diff --git a/checkout_granite.sh b/checkout_granite.sh
index 568ee12..e3da299 100755
--- a/checkout_granite.sh
+++ b/checkout_granite.sh
@@ -24,3 +24,16 @@ update() {
 cd Granite
 update third_party/volk
 update third_party/khronos/vulkan-headers
+
+# Maintained Granite changes, applied in order (later patches build on
+# earlier ones): HDR-to-SDR normalization, then 1:1 scaler overlays.
+# shaders/slangmosh_scaler.hpp is generated from the patched scaler.
+cd ..
+for name in granite-sdr-normalization.patch granite-scaler-overlay.patch; do
+	patch_file="$PWD/patches/$name"
+	if git apply --check "$patch_file"; then
+		git apply "$patch_file"
+	else
+		git apply --reverse --check "$patch_file" || exit 1
+	fi
+done
diff --git a/patches/granite-scaler-overlay.patch b/patches/granite-scaler-overlay.patch
new file mode 100644
index 0000000..1c754d4
--- /dev/null
+++ b/patches/granite-scaler-overlay.patch
@@ -0,0 +1,164 @@
+diff --git a/Granite/assets/shaders/util/scaler.comp b/Granite/assets/shaders/util/scaler.comp
+index 7fca0dc..3b51665 100644
+--- a/Granite/assets/shaders/util/scaler.comp
++++ b/Granite/assets/shaders/util/scaler.comp
+@@ -12,6 +12,7 @@ const int CONTROL_CLAMP_COORD_BIT = 1 << 3;
+ const int CONTROL_CHROMA_SUBSAMPLE_BIT = 1 << 4;
+ const int CONTROL_PRIMARY_CONVERSION_BIT = 1 << 5;
+ const int CONTROL_DITHER_BIT = 1 << 6;
++const int CONTROL_OVERLAY_BIT = 1 << 7;
+ layout(constant_id = 0) const int CONTROL = 0;
+ 
+ const bool SKIP_RESCALE = (CONTROL & CONTROL_SKIP_RESCALE_BIT) != 0;
+@@ -21,6 +22,7 @@ const bool CLAMP_COORD = (CONTROL & CONTROL_CLAMP_COORD_BIT) != 0;
+ const bool CHROMA_SUBSAMPLE = (CONTROL & CONTROL_CHROMA_SUBSAMPLE_BIT) != 0;
+ const bool PRIMARY_CONVERSION = (CONTROL & CONTROL_PRIMARY_CONVERSION_BIT) != 0;
+ const bool DITHER = (CONTROL & CONTROL_DITHER_BIT) != 0;
++const bool OVERLAY = (CONTROL & CONTROL_OVERLAY_BIT) != 0;
+ 
+ const int TRANSFER_IDENTITY = 0;
+ const int TRANSFER_SRGB = 1;
+@@ -62,6 +64,10 @@ layout(set = 0, binding = 4) uniform UBO
+ 
+ layout(set = 0, binding = 5) writeonly uniform mediump image2D uChromaPlane2;
+ layout(set = 0, binding = 6) writeonly uniform mediump image2D uChromaPlane3;
++// Up to two premultiplied layers composited 1:1 over the input, bottom to
++// top, before any transfer function, as a compositor blends into its output.
++layout(set = 0, binding = 7) uniform mediump texture2D uOverlay0;
++layout(set = 0, binding = 8) uniform mediump texture2D uOverlay1;
+ 
+ ivec2 unswizzle8x8(uint index)
+ {
+@@ -85,10 +91,41 @@ layout(push_constant) uniform Registers
+     vec2 crop_bias;
+     vec2 crop_scale;
+     float dither_strength;
++    // Per layer: offset.xy and size.zw in input texels; zero size disables.
++    ivec4 overlay_rect[2];
++    // Element alpha per layer (compositor opacity).
++    vec2 overlay_opacity;
++    // Non-zero: ignore the texel alpha (X formats).
++    uvec2 overlay_opaque;
+ } registers;
+ 
+ #include "../inc/srgb.h"
+ 
++f16vec4 blend_overlay(f16vec4 v, ivec2 input_coord, int i)
++{
++    ivec4 rect = registers.overlay_rect[i];
++    ivec2 rel = input_coord - rect.xy;
++    if (any(lessThan(rel, ivec2(0))) || any(greaterThanEqual(rel, rect.zw)))
++        return v;
++    f16vec4 o = f16vec4(i == 0 ? texelFetch(uOverlay0, rel, 0) : texelFetch(uOverlay1, rel, 0));
++    if (registers.overlay_opaque[i] != 0u)
++        o.a = float16_t(1.0);
++    // A compositor draws texel * element alpha, blended ONE, ONE_MINUS_SRC_ALPHA.
++    o *= float16_t(registers.overlay_opacity[i]);
++    v.rgb = o.rgb + v.rgb * (float16_t(1.0) - o.a);
++    return v;
++}
++
++f16vec4 apply_overlay(f16vec4 v, ivec2 input_coord)
++{
++    if (OVERLAY)
++    {
++        v = blend_overlay(v, input_coord, 0);
++        v = blend_overlay(v, input_coord, 1);
++    }
++    return v;
++}
++
+ f16vec4 apply_eotf(f16vec4 v)
+ {
+     if (EOTF == TRANSFER_SRGB)
+@@ -274,6 +311,8 @@ void main()
+         else
+         {
+             final_result = f16vec4(texelFetch(uTexture, coord + registers.crop_offset, 0));
++            // The host only enables overlays for unsampled 1:1 input.
++            final_result = apply_overlay(final_result, coord + registers.crop_offset);
+         }
+ 
+         final_result = apply_eotf(final_result);
