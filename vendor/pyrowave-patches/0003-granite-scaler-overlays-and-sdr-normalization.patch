+@@ -196,6 +197,10 @@ void VideoScaler::rescale(CommandBuffer &cmd, const RescaleInfo &info)
+ 		vec2 crop_bias;
+ 		vec2 crop_scale;
+ 		float dither_strength;
++		float padding;
++		ivec4 overlay_rect[2];
++		vec2 overlay_opacity;
++		uvec2 overlay_opaque;
+ 	};
+ 
+ 	Push push = {};
+@@ -322,6 +327,23 @@ void VideoScaler::rescale(CommandBuffer &cmd, const RescaleInfo &info)
+ 		}
+ 	}
+ 
++	for (unsigned i = 0; i < 2; i++)
++	{
++		auto &overlay = info.overlays[i];
++		if (!overlay.view)
++			continue;
++		if ((flags & CONTROL_SKIP_RESCALE_BIT) == 0 || (flags & CONTROL_SAMPLED_SCALING_BIT) != 0)
++		{
++			LOGE("Overlays require identity, unsampled scaling.\n");
++			return;
++		}
++		flags |= CONTROL_OVERLAY_BIT;
++		push.overlay_rect[i] = ivec4(overlay.offset.x, overlay.offset.y,
++		                             int(overlay.view->get_view_width()), int(overlay.view->get_view_height()));
++		push.overlay_opacity[i] = overlay.opacity;
++		push.overlay_opaque[i] = overlay.opaque ? 1u : 0u;
++	}
++
+ 	if (oetf == eotf && (flags & CONTROL_SKIP_RESCALE_BIT) != 0)
+ 	{
+ 		eotf = TRANSFER_IDENTITY;
+@@ -402,6 +424,9 @@ void VideoScaler::rescale(CommandBuffer &cmd, const RescaleInfo &info)
+ 		ubo->primary_transform[2] = vec4(sdr_scale * conv[2], 0.0f);
+ 	}
+ 
++	// Never sampled when disabled, but the bindings must be valid.
++	for (unsigned i = 0; i < 2; i++)
++		cmd.set_texture(0, 7 + i, info.overlays[i].view ? *info.overlays[i].view : *info.input);
+ 	cmd.set_unorm_storage_texture(0, 5, *info.output_planes[info.num_output_planes >= 2 ? 1 : 0]);
+ 	cmd.set_unorm_storage_texture(0, 6, *info.output_planes[info.num_output_planes >= 3 ? 2 : 0]);
+ 
