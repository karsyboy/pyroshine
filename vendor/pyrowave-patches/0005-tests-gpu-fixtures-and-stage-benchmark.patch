+            VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT);
+        BufferCreateInfo b {}; b.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
