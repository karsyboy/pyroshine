From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pyroshine Vendor Maintenance <vendor@pyroshine.invalid>
Date: Mon, 12 Oct 2026 16:22:53 -0400
Subject: [PATCH] joined native worker threads

Own and join native UHID/uinput workers before releasing device resources,
guard shared report/callback state, and retain the device lifetime tests.
Reconstructed from the existing Pyroshine vendor change through 3f61cf8.
---
 CMakeLists.txt                                |  12 +
 include/inputtino/input.hpp                   |   1 +
 src/uhid/include/uhid/protected_types.hpp     |   9 +-
 src/uhid/include/uhid/uhid.hpp                |  49 +++-
 src/uhid/joypad_ps5.cpp                       | 103 +++++---
 .../include/inputtino/protected_types.hpp     |  13 +-
 src/uinput/joypad_nintendo.cpp                |  11 +-
 src/uinput/joypad_ps.cpp                      |  11 +-
 src/uinput/joypad_utils.hpp                   |  48 +++-
 src/uinput/joypad_xbox.cpp                    |  11 +-
 tests/joypad_lifetimes.cpp                    | 225 ++++++++++++++++++
 11 files changed, 428 insertions(+), 65 deletions(-)
 create mode 100644 tests/joypad_lifetimes.cpp

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7865ec8..a7d8edd 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -208,6 +208,18 @@ if(INPUTTINO_PS5_FEATURE_TESTS AND USE_UHID)
     endforeach()
 endif()
 
+# Thread/lifetime checks on real devices; needs read/write access to /dev/uhid
+# and /dev/uinput. Configure with -fsanitize=thread (or address) to be useful.
+option(INPUTTINO_DEVICE_TESTS "Test native joypad threads and destruction on /dev/uhid and /dev/uinput" OFF)
+if(INPUTTINO_DEVICE_TESTS)
+    enable_testing()
+    add_executable(joypad-lifetime-test tests/joypad_lifetimes.cpp)
+    target_link_libraries(joypad-lifetime-test PRIVATE inputtino::libinputtino)
+    add_test(NAME joypad-lifetimes COMMAND joypad-lifetime-test 5)
+    # Exit status 77: the devices are not accessible on this host.
+    set_tests_properties(joypad-lifetimes PROPERTIES SKIP_RETURN_CODE 77)
+endif()
+
 option(INPUTTINO_ELITE_TESTS "Test Xbox Elite evdev capabilities without uinput" OFF)
 if(INPUTTINO_ELITE_TESTS)
     enable_testing()
