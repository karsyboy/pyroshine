 src/uinput/joypad_xbox.cpp                    | 20 ++++++++-
 tests/xbox_elite.cpp                          | 45 +++++++++++++++++++
 5 files changed, 111 insertions(+), 3 deletions(-)
 create mode 100644 src/uinput/include/inputtino/xbox_elite.hpp
 create mode 100644 tests/xbox_elite.cpp

