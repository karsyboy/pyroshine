From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pyroshine Vendor Maintenance <vendor@pyroshine.invalid>
Date: Mon, 19 Oct 2026 16:13:48 -0400
Subject: [PATCH] Validate rate control mode and bitrate against encoder
 capabilities

EncoderCapabilities now carries the profile's rate control modes and
maximum bitrate, and check_rate_control() rejects an unsupported mode or a
bitrate above the maximum before encoder creation. Both are valid-usage
requirements that drivers do not report: ANV's Gen12 encoder offers only
disabled rate control, and NVIDIA limits H.264/HEVC to 120 Mbps on an
RTX 3080.
---
 src/encoder/capabilities.rs | 83 ++++++++++++++++++++++++++++++++++++-
 src/encoder/codec.rs        | 29 +++++++++++++
 2 files changed, 111 insertions(+), 1 deletion(-)

diff --git a/src/encoder/capabilities.rs b/src/encoder/capabilities.rs
index 87b0dfe..d5c6e99 100644
--- a/src/encoder/capabilities.rs
+++ b/src/encoder/capabilities.rs
@@ -4,7 +4,7 @@ use ash::vk::TaggedStructure;
 
 use super::codec::{DeviceVideoCaps, input_image_width, query_video_caps};
 use super::profile::EncodeProfile;
-use super::{Codec, EncodeConfig};
+use super::{Codec, EncodeConfig, RateControl};
 use crate::VideoContext;
 use crate::error::{PixelForgeError, Result};
 use crate::video::gcd;
@@ -29,6 +29,10 @@ pub struct EncoderCapabilities {
     pub picture_access_granularity: vk::Extent2D,
     /// AV1's picture grid. Other codecs crop directly to the requested frame.
     pub av1_coded_picture_alignment: Option<vk::Extent2D>,
+    /// Rate control modes the profile supports.
+    pub rate_control_modes: vk::VideoEncodeRateControlModeFlagsKHR,
+    /// Highest average or peak bitrate a rate-controlled stream may request, in bits per second.
+    pub max_bitrate: u64,
 }
 
 impl EncoderCapabilities {
@@ -61,9 +65,46 @@ impl EncoderCapabilities {
             max_coded_extent: caps.max_coded_extent,
             picture_access_granularity: caps.picture_access_granularity,
             av1_coded_picture_alignment: caps.av1_coded_picture_alignment,
+            rate_control_modes: caps.rate_control_modes,
+            max_bitrate: caps.max_bitrate,
         }
     }
 
+    /// Reject a rate control mode the profile does not support, or a bitrate
+    /// above its maximum, instead of passing them to the driver.
+    ///
+    /// Both are valid-usage requirements of `vkCmdControlVideoCodingKHR`.
+    /// ANV's Gen12 encoder (with `ANV_DEBUG=video-encode`) offers only
+    /// disabled rate control, and NVIDIA limits H.264 and HEVC to 120 Mbps on
+    /// an RTX 3080; drivers do not report a violation, so it must be caught here.
+    pub fn check_rate_control(&self, config: &EncodeConfig) -> Result<()> {
+        let (mode, peak) = match config.rate_control {
+            RateControl::Cqp { .. } => (vk::VideoEncodeRateControlModeFlagsKHR::DISABLED, None),
+            RateControl::Cbr { bitrate } => {
+                (vk::VideoEncodeRateControlModeFlagsKHR::CBR, Some(bitrate))
+            }
+            RateControl::Vbr { target, max } => (
+                vk::VideoEncodeRateControlModeFlagsKHR::VBR,
+                Some(target.max(max)),
+            ),
+        };
+        if !self.rate_control_modes.contains(mode) {
+            return Err(PixelForgeError::InvalidInput(format!(
+                "{:?} on this GPU does not support {:?} rate control (supported: {:?})",
+                config.codec, mode, self.rate_control_modes
+            )));
+        }
+        if let Some(peak) = peak
+            && u64::from(peak) > self.max_bitrate
+        {
+            return Err(PixelForgeError::InvalidInput(format!(
+                "{:?} on this GPU encodes at most {} bps; {peak} bps requested",
+                config.codec, self.max_bitrate
+            )));
+        }
+        Ok(())
+    }
+
     /// Align to both codec blocks and device granularity, clamp to the minimum
     /// and re-align. Reject zero dimensions, overflow and extents above the max.
     pub fn coded_extent(&self, codec: Codec, width: u32, height: u32) -> Result<vk::Extent2D> {
@@ -168,9 +209,49 @@ mod tests {
                 height: granularity.1,
             },
             av1_coded_picture_alignment: None,
+            rate_control_modes: vk::VideoEncodeRateControlModeFlagsKHR::DISABLED
+                | vk::VideoEncodeRateControlModeFlagsKHR::CBR
+                | vk::VideoEncodeRateControlModeFlagsKHR::VBR,
+            max_bitrate: 120_000_000,
         }
     }
 
+    #[test]
+    fn unsupported_rate_control_and_excess_bitrate_are_rejected() {
+        let cbr = |bitrate| {
+            EncodeConfig::h264(1920, 1080).with_rate_control(RateControl::Cbr { bitrate })
+        };
+        let limits = caps((1, 1), (1, 1), 8192);
+        assert!(limits.check_rate_control(&cbr(120_000_000)).is_ok());
+        let error = limits.check_rate_control(&cbr(150_000_000)).unwrap_err();
+        assert!(
+            error.to_string().contains("at most 120000000 bps"),
+            "{error}"
+        );
+        let vbr = EncodeConfig::h264(1920, 1080).with_rate_control(RateControl::Vbr {
+            target: 50_000_000,
+            max: 130_000_000,
+        });
+        assert!(limits.check_rate_control(&vbr).is_err());
+        // Constant QP ignores the bitrate.
+        let cqp = EncodeConfig::h264(1920, 1080).with_rate_control(RateControl::Cqp { qp: 30 });
+        assert!(limits.check_rate_control(&cqp).is_ok());
+
+        let disabled_only = EncoderCapabilities {
+            rate_control_modes: vk::VideoEncodeRateControlModeFlagsKHR::DISABLED,
+            max_bitrate: 0,
+            ..limits
+        };
+        let error = disabled_only
+            .check_rate_control(&cbr(10_000_000))
+            .unwrap_err();
+        assert!(
+            error.to_string().contains("does not support CBR"),
+            "{error}"
+        );
+        assert!(disabled_only.check_rate_control(&cqp).is_ok());
+    }
+
     #[test]
     fn coded_and_allocated_extents_are_distinct() {
         let limits = caps((1, 1), (1, 1), 8192);
diff --git a/src/encoder/codec.rs b/src/encoder/codec.rs
index 33c4383..b5d22c4 100644
--- a/src/encoder/codec.rs
+++ b/src/encoder/codec.rs
@@ -796,6 +796,10 @@ pub(crate) struct DeviceVideoCaps {
     /// AV1's coded picture grid; set by the AV1 encoder, which chains the
     /// AV1 capability struct.
     pub av1_coded_picture_alignment: Option<vk::Extent2D>,
+    /// Rate control modes the profile supports.
+    pub rate_control_modes: vk::VideoEncodeRateControlModeFlagsKHR,
+    /// Highest average or peak bitrate, in bits per second.
+    pub max_bitrate: u64,
 }
 
 /// Call `vkGetPhysicalDeviceVideoCapabilitiesKHR` and return its raw result.
@@ -835,6 +839,7 @@ pub(crate) fn query_video_caps(
             result
         )));
     }
+    let encode_rate_control = chained_rate_control(capabilities);
     Ok(DeviceVideoCaps {
         picture_access_granularity: capabilities.picture_access_granularity,
         min_coded_extent: capabilities.min_coded_extent,
@@ -844,9 +849,32 @@ pub(crate) fn query_video_caps(
         flags: capabilities.flags,
         std_header_version: capabilities.std_header_version,
         av1_coded_picture_alignment: None,
+        rate_control_modes: encode_rate_control.0,
+        max_bitrate: encode_rate_control.1,
     })
 }
 
+/// The rate control modes and maximum bitrate from the
+/// `VkVideoEncodeCapabilitiesKHR` chained into `capabilities`, which every
+/// encode capability query includes; none and 0 without it.
+fn chained_rate_control(
+    capabilities: &vk::VideoCapabilitiesKHR,
+) -> (vk::VideoEncodeRateControlModeFlagsKHR, u64) {
+    let mut next = capabilities.p_next.cast::<vk::BaseOutStructure>();
+    while !next.is_null() {
+        // SAFETY: the caller built the chain from live Vulkan output structs,
+        // each starting with sType and pNext.
+        let base = unsafe { &*next };
+        if base.s_type == vk::StructureType::VIDEO_ENCODE_CAPABILITIES_KHR {
+            // SAFETY: the sType identifies the structure.
+            let encode = unsafe { &*next.cast::<vk::VideoEncodeCapabilitiesKHR>() };
+            return (encode.rate_control_modes, encode.max_bitrate);
+        }
+        next = base.p_next;
+    }
+    (vk::VideoEncodeRateControlModeFlagsKHR::empty(), 0)
+}
