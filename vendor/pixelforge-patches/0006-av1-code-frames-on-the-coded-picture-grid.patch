 src/encoder/av1/session_params.rs |  4 +--
 src/encoder/capabilities.rs       | 53 +++++++++++++++++++++++++++++++
 src/encoder/external.rs           | 21 ++++++++++--
 6 files changed, 90 insertions(+), 8 deletions(-)

