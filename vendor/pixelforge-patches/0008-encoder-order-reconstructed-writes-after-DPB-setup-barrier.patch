From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pyroshine Vendor Maintenance <vendor@pyroshine.invalid>
Date: Mon, 12 Oct 2026 18:23:21 -0400
Subject: [PATCH] encoder: order reconstructed-picture writes after the DPB
 setup barrier

The setup slot's barrier had empty access masks, so the encode's write of
the reconstructed picture was not ordered after the layout transition or
after the slot's previous encode (SYNC-HAZARD-WRITE-AFTER-WRITE with
synchronization validation, on RADV and NVIDIA). Make prior writes
available and the transition visible to later reads and writes. Legacy
access flags have no video-encode bits; MEMORY_READ/MEMORY_WRITE cover
them.
---
 src/encoder/resources.rs | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/encoder/resources.rs b/src/encoder/resources.rs
index 6dad1f7..572b691 100644
--- a/src/encoder/resources.rs
+++ b/src/encoder/resources.rs
@@ -1204,8 +1204,11 @@ pub(crate) unsafe fn record_dpb_barriers(
             base_array_layer: dpb_base_array_layer,
             layer_count: 1,
         })
-        .src_access_mask(vk::AccessFlags::empty())
-        .dst_access_mask(vk::AccessFlags::empty());
+        // The encode writes the reconstructed picture after this transition
+        // and after the slot's previous encode (write-after-write). Legacy
+        // barriers have no video-encode access flags; MEMORY_* covers them.
+        .src_access_mask(vk::AccessFlags::MEMORY_WRITE)
+        .dst_access_mask(vk::AccessFlags::MEMORY_READ | vk::AccessFlags::MEMORY_WRITE);
 
     let mut all_barriers = vec![dpb_barrier];
 
-- 
