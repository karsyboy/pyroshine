@@ -150,6 +166,7 @@ pub struct VideoContextBuilder {
     unified_image_layouts: Option<bool>,
     queues: QueueOverrides,
     device_selector: Option<DeviceSelector>,
+    allow_without_encode: bool,
 }
 
 impl Default for VideoContextBuilder {
