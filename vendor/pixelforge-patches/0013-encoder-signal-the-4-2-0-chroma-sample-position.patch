From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pyroshine Vendor Maintenance <vendor@pyroshine.invalid>
Date: Thu, 12 Nov 2026 11:38:22 -0500
Subject: [PATCH] encoder: signal the producer's 4:2:0 chroma sample position

Upstream writes chroma_sample_loc_type 0 (left) for every 4:2:0 H.264/H.265
stream and the AV1 vertical position, which matches its own RGB conversion.
A caller that converts itself may site chroma elsewhere: Pyroshine's
converter centers H.264/HEVC chroma (a 2x2 mean). Add
ColorDescription::chroma_location (ChromaLocation, default Left, so the
upstream signalling is unchanged), written as H.264/H.265 VUI
chroma_loc_info and AV1 chroma_sample_position, for 4:2:0 only.
---
 src/encoder/av1/session_params.rs  |  7 +--
 src/encoder/h264/session_params.rs | 16 +++----
 src/encoder/h265/session_params.rs | 14 ++++--
 src/encoder/mod.rs                 | 74 ++++++++++++++++++++++++++++++
 src/lib.rs                         |  6 +--
 5 files changed, 98 insertions(+), 19 deletions(-)

diff --git a/src/encoder/av1/session_params.rs b/src/encoder/av1/session_params.rs
index bb4a30a..7a3a5ab 100644
--- a/src/encoder/av1/session_params.rs
+++ b/src/encoder/av1/session_params.rs
@@ -70,10 +70,11 @@ impl Av1 {
             color_primaries: av1_color_primaries,
             transfer_characteristics: av1_transfer,
             matrix_coefficients: av1_matrix,
-            // 4:2:0 chroma sits on the left luma sample, midway between the
-            // two rows. Only 4:2:0 writes a position at all.
+            // Only 4:2:0 carries a position (AV1 spec 5.5.2).
             chroma_sample_position: if subsampling_x == 1 && subsampling_y == 1 {
-                ash::vk::native::StdVideoAV1ChromaSamplePosition_STD_VIDEO_AV1_CHROMA_SAMPLE_POSITION_VERTICAL
+                ash::vk::native::StdVideoAV1ChromaSamplePosition::from(
+                    desc.chroma_location.av1_sample_position(),
+                )
             } else {
                 ash::vk::native::StdVideoAV1ChromaSamplePosition_STD_VIDEO_AV1_CHROMA_SAMPLE_POSITION_UNKNOWN
             },
