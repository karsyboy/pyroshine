         let codec = Av1 {
             frame_num: 0,
@@ -59,6 +62,7 @@ impl Av1 {
             header_data: None,
             references: Vec::new(),
             active_reference_count,
+            frame_extent,
         };
 
         let mut encoder = CodecEncoder { common, codec };
