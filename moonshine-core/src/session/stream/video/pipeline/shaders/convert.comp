#version 450
// RGB -> encoder-input YCbCr conversion for the conventional (Vulkan Video,
// VA-API, NVENC) codecs, optionally compositing up to two premultiplied-alpha layers (a Steam
// notification, then the cursor) while sampling the source.
//
// Output is a buffer holding one plane after the other; each plane row starts
// on a 32-bit word and rows are `*_pitch` words apart. Packed 4:4:4 formats
// have a single plane of one word per pixel. The buffer is copied into the
// encoder's input afterwards (see `convert.rs`, `Layout`).
//
// Each invocation owns a 4x2 pixel block and therefore whole 32-bit output
// words (four 8-bit or two 16-bit luma samples per row, plus the chroma
// words of the same pixels): no atomics and no buffer clear are needed. The
// block grid covers the padded conversion extent rounded up to whole blocks;
// pixels outside the logical frame replicate its nearest edge pixel, which
// also fills the encoder's alignment padding deterministically.
//
// The block is written out sample by sample on purpose. An earlier version
// kept it in a dynamically indexed `vec3[2][4]` filled and read in loops; on
// an NVIDIA Blackwell GPU exactly the second chroma sample of every block came
// out wrong (green, vertically striped video) while luma stayed intact. Keep
// this shader free of private arrays and data-dependent loops.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    // Logical frame extent; samples outside it replicate the edge.
    uint width;
    uint height;
    // Largest source texel coordinate that holds image content.
    uint source_max_x;
    uint source_max_y;
    uint output_format;  // 0=NV12, 2=YUV444, 3=P010, 4=YUV444P10, 5=XYUV, 6=Y410
    uint color_space;    // 0=BT.709, 1=BT.2020, 2=sRGB->BT.2020+PQ, 3=scRGB linear->BT.2020+PQ
    uint full_range;
    float sdr_white_nits;
    // Plane layout in 32-bit words.
    uint luma_pitch;
    uint chroma_offset;
    uint chroma_pitch;
    // Block grid (4x2 pixels per invocation).
    uint blocks_x;
    uint blocks_y;
    // Non-zero: the whole source is scaled onto the logical frame (Desktop
    // Mode, whose output size is not the stream's); zero samples 1:1.
    uint scaled;
    // Layer rectangles in output pixels (x, y, width, height), bottom to top;
    // width 0 disables a layer.
    ivec4 layer_rect[2];
    // GLES element alpha per layer.
    vec2 layer_opacity;
    // Non-zero: ignore the texel alpha (X formats).
    uvec2 layer_opaque;
    // Scaled sources: where the source lands (x, y, width, height); black
    // outside it, so a source of another aspect ratio is not distorted.
    uvec4 viewport;
} params;

layout(binding = 0) uniform sampler2D inputImage;

layout(std430, binding = 1) writeonly buffer OutputBuffer {
    uint output_data[];
};

// Premultiplied layers sampled 1:1 with texelFetch.
layout(binding = 2) uniform sampler2D layerImage0;
layout(binding = 3) uniform sampler2D layerImage1;

// Luma weights (Rec. ITU-R BT.709 and BT.2020 non-constant luminance).
const float BT709_KR = 0.2126;
const float BT709_KB = 0.0722;
const float BT2020_KR = 0.2627;
const float BT2020_KB = 0.0593;

const float PQ_M1 = 0.1593017578125;
const float PQ_M2 = 78.84375;
const float PQ_C1 = 0.8359375;
const float PQ_C2 = 18.8515625;
const float PQ_C3 = 18.6875;

vec3 linear_to_pq(vec3 L) {
    L = max(L, vec3(0.0));
    vec3 Lm1 = pow(L, vec3(PQ_M1));
    return pow((PQ_C1 + PQ_C2 * Lm1) / (1.0 + PQ_C3 * Lm1), vec3(PQ_M2));
}

vec3 srgb_to_linear(vec3 srgb) {
    srgb = clamp(srgb, 0.0, 1.0);
    return mix(
        pow((srgb + 0.055) / 1.055, vec3(2.4)),
        srgb / 12.92,
        lessThanEqual(srgb, vec3(0.04045))
    );
}

// Rec. ITU-R BT.2087 linear BT.709 -> BT.2020 primaries.
vec3 bt709_to_bt2020(vec3 rgb709) {
    return vec3(
        0.6274 * rgb709.r + 0.3293 * rgb709.g + 0.0433 * rgb709.b,
        0.0691 * rgb709.r + 0.9195 * rgb709.g + 0.0114 * rgb709.b,
        0.0164 * rgb709.r + 0.0880 * rgb709.g + 0.8956 * rgb709.b
    );
}

// GLES draws a texture element as texel * alpha (premultiplied) with
// ONE, ONE_MINUS_SRC_ALPHA blending; X formats sample alpha as one.
vec3 blend_layer0(vec3 dst, ivec2 coord) {
    ivec4 rect = params.layer_rect[0];
    ivec2 rel = coord - rect.xy;
    if (rect.z == 0 || any(lessThan(rel, ivec2(0))) || any(greaterThanEqual(rel, rect.zw)))
        return dst;
    vec4 o = texelFetch(layerImage0, rel, 0);
    if (params.layer_opaque.x != 0u)
        o.a = 1.0;
    o *= params.layer_opacity.x;
    return o.rgb + dst * (1.0 - o.a);
}

vec3 blend_layer1(vec3 dst, ivec2 coord) {
    ivec4 rect = params.layer_rect[1];
    ivec2 rel = coord - rect.xy;
    if (rect.z == 0 || any(lessThan(rel, ivec2(0))) || any(greaterThanEqual(rel, rect.zw)))
        return dst;
    vec4 o = texelFetch(layerImage1, rel, 0);
    if (params.layer_opaque.y != 0u)
        o.a = 1.0;
    o *= params.layer_opacity.y;
    return o.rgb + dst * (1.0 - o.a);
}

// Composited RGB of frame pixel `coord` (inside the logical frame), in the
// encoder's signal encoding.
vec3 read_rgb(ivec2 coord) {
    vec3 rgb = vec3(0.0);
    if (params.scaled != 0u) {
        ivec2 rel = coord - ivec2(params.viewport.xy);
        if (all(greaterThanEqual(rel, ivec2(0))) && all(lessThan(rel, ivec2(params.viewport.zw)))) {
            // Four bilinear taps a quarter output pixel around the center: a
            // 2x2-supersampled bilinear filter, which also averages a 2:1 (or
            // smaller) downscale without skipping source texels.
            vec2 size = vec2(params.viewport.zw);
            vec2 center = (vec2(rel) + 0.5) / size;
            vec2 quarter = 0.25 / size;
            rgb = 0.25 * (textureLod(inputImage, center + vec2(-quarter.x, -quarter.y), 0.0).rgb
                        + textureLod(inputImage, center + vec2( quarter.x, -quarter.y), 0.0).rgb
                        + textureLod(inputImage, center + vec2(-quarter.x,  quarter.y), 0.0).rgb
                        + textureLod(inputImage, center + vec2( quarter.x,  quarter.y), 0.0).rgb);
        }
    } else {
        ivec2 texel = min(coord, ivec2(params.source_max_x, params.source_max_y));
        rgb = texelFetch(inputImage, texel, 0).rgb;
    }
    // Late composition happens in the source's encoding, exactly where the
    // GLES compositor blends these elements into its output buffer.
    rgb = blend_layer0(rgb, coord);
    rgb = blend_layer1(rgb, coord);
    if (params.color_space == 2u) {
        vec3 linear_2020 = bt709_to_bt2020(srgb_to_linear(rgb));
        return linear_to_pq(linear_2020 * (params.sdr_white_nits / 10000.0));
    }
    if (params.color_space == 3u) {
        vec3 linear_2020 = bt709_to_bt2020(rgb);
        return linear_to_pq(linear_2020 * (params.sdr_white_nits / 10000.0));
    }
    return rgb;
}

// Normalized (Y, Cb + 0.5, Cr + 0.5), each clamped to [0, 1].
vec3 rgb_to_yuv(vec3 rgb) {
    float kr = params.color_space >= 1u ? BT2020_KR : BT709_KR;
    float kb = params.color_space >= 1u ? BT2020_KB : BT709_KB;
    float y = kr * rgb.r + (1.0 - kr - kb) * rgb.g + kb * rgb.b;
    float u = (rgb.b - y) * (0.5 / (1.0 - kb)) + 0.5;
    float v = (rgb.r - y) * (0.5 / (1.0 - kr)) + 0.5;
    return clamp(vec3(y, u, v), 0.0, 1.0);
}

// YCbCr of output pixel (x, y); coordinates past the frame edge replicate it.
vec3 pixel(uint x, uint y) {
    ivec2 coord = ivec2(min(x, params.width - 1u), min(y, params.height - 1u));
    return rgb_to_yuv(read_rgb(coord));
}

// Rec. ITU-R BT.709 / BT.2100 quantization (round to nearest), clamped to
// the code range: limited range scales luma to 219 and chroma to 224 times
// 2^(bits - 8) around offsets 16 and 128; full range uses 2^bits - 1.
uint quantize(float value, float max_code) {
    return uint(clamp(value + 0.5, 0.0, max_code));
}

uint q8_y(float y) {
    return quantize(params.full_range == 0u ? y * 219.0 + 16.0 : y * 255.0, 255.0);
}

uint q8_c(float c) {
    return quantize(params.full_range == 0u ? (c - 0.5) * 224.0 + 128.0 : (c - 0.5) * 255.0 + 128.0, 255.0);
}

// 10-bit samples sit in the high bits of 16-bit words (P010 layout).
uint q10_y(float y) {
    return quantize(params.full_range == 0u ? y * 876.0 + 64.0 : y * 1023.0, 1023.0) << 6u;
}

uint q10_c(float c) {
    return quantize(params.full_range == 0u ? (c - 0.5) * 896.0 + 512.0 : (c - 0.5) * 1023.0 + 512.0, 1023.0) << 6u;
}

// 2x2 box filter for 4:2:0 chroma, summed in the order (00, 10, 01, 11).
vec2 chroma_420(vec3 p00, vec3 p10, vec3 p01, vec3 p11) {
    return (p00.yz + p10.yz + p01.yz + p11.yz) / 4.0;
}

uint pack_y8(vec3 p0, vec3 p1, vec3 p2, vec3 p3) {
    return q8_y(p0.x) | (q8_y(p1.x) << 8u) | (q8_y(p2.x) << 16u) | (q8_y(p3.x) << 24u);
}

uint pack_y10(vec3 p0, vec3 p1) {
    return q10_y(p0.x) | (q10_y(p1.x) << 16u);
}

uint pack_c8(vec2 c0, vec2 c1) {
    return q8_c(c0.x) | (q8_c(c0.y) << 8u) | (q8_c(c1.x) << 16u) | (q8_c(c1.y) << 24u);
}

uint pack_c10(vec2 c) {
    return q10_c(c.x) | (q10_c(c.y) << 16u);
}

// Packed 4:4:4, one word per pixel. XYUV: Cr, Cb, Y, 0xFF from the lowest
// byte. Y410: Cb bits 0-9, Y 10-19, Cr 20-29, alpha 3 in bits 30-31.
uint pack_xyuv(vec3 p) {
    return q8_c(p.z) | (q8_c(p.y) << 8u) | (q8_y(p.x) << 16u) | (0xffu << 24u);
}

uint pack_y410(vec3 p) {
    return (q10_c(p.y) >> 6u) | ((q10_y(p.x) >> 6u) << 10u) | ((q10_c(p.z) >> 6u) << 20u) | (3u << 30u);
}

void main() {
    uint bx = gl_GlobalInvocationID.x;
    uint by = gl_GlobalInvocationID.y;
    if (bx >= params.blocks_x || by >= params.blocks_y) return;
    uint x0 = bx * 4u;
    uint y0 = by * 2u;

    // Row a is y0, row b is y0 + 1.
    vec3 a0 = pixel(x0, y0);
    vec3 a1 = pixel(x0 + 1u, y0);
    vec3 a2 = pixel(x0 + 2u, y0);
    vec3 a3 = pixel(x0 + 3u, y0);
    vec3 b0 = pixel(x0, y0 + 1u);
    vec3 b1 = pixel(x0 + 1u, y0 + 1u);
    vec3 b2 = pixel(x0 + 2u, y0 + 1u);
    vec3 b3 = pixel(x0 + 3u, y0 + 1u);

    uint row_a = y0 * params.luma_pitch;
    uint row_b = row_a + params.luma_pitch;

    if (params.output_format == 0u) {
        // NV12: 8-bit luma; one UVUV word per block on chroma row `by`.
        output_data[row_a + bx] = pack_y8(a0, a1, a2, a3);
        output_data[row_b + bx] = pack_y8(b0, b1, b2, b3);
        uint c = params.chroma_offset + by * params.chroma_pitch + bx;
        output_data[c] = pack_c8(chroma_420(a0, a1, b0, b1), chroma_420(a2, a3, b2, b3));
    } else if (params.output_format == 3u) {
        // P010: 16-bit luma; one UV word per chroma sample on chroma row `by`.
        output_data[row_a + 2u * bx] = pack_y10(a0, a1);
        output_data[row_a + 2u * bx + 1u] = pack_y10(a2, a3);
        output_data[row_b + 2u * bx] = pack_y10(b0, b1);
        output_data[row_b + 2u * bx + 1u] = pack_y10(b2, b3);
        uint c = params.chroma_offset + by * params.chroma_pitch + 2u * bx;
        output_data[c] = pack_c10(chroma_420(a0, a1, b0, b1));
        output_data[c + 1u] = pack_c10(chroma_420(a2, a3, b2, b3));
    } else if (params.output_format == 2u) {
        // YUV444 8-bit: 8-bit luma; interleaved UV per pixel, two pixels per word.
        output_data[row_a + bx] = pack_y8(a0, a1, a2, a3);
        output_data[row_b + bx] = pack_y8(b0, b1, b2, b3);
        uint ca = params.chroma_offset + y0 * params.chroma_pitch + 2u * bx;
        uint cb = ca + params.chroma_pitch;
        output_data[ca] = pack_c8(a0.yz, a1.yz);
        output_data[ca + 1u] = pack_c8(a2.yz, a3.yz);
        output_data[cb] = pack_c8(b0.yz, b1.yz);
        output_data[cb + 1u] = pack_c8(b2.yz, b3.yz);
    } else if (params.output_format == 5u) {
        output_data[row_a + 4u * bx] = pack_xyuv(a0);
        output_data[row_a + 4u * bx + 1u] = pack_xyuv(a1);
        output_data[row_a + 4u * bx + 2u] = pack_xyuv(a2);
        output_data[row_a + 4u * bx + 3u] = pack_xyuv(a3);
        output_data[row_b + 4u * bx] = pack_xyuv(b0);
        output_data[row_b + 4u * bx + 1u] = pack_xyuv(b1);
        output_data[row_b + 4u * bx + 2u] = pack_xyuv(b2);
        output_data[row_b + 4u * bx + 3u] = pack_xyuv(b3);
    } else if (params.output_format == 6u) {
        output_data[row_a + 4u * bx] = pack_y410(a0);
        output_data[row_a + 4u * bx + 1u] = pack_y410(a1);
        output_data[row_a + 4u * bx + 2u] = pack_y410(a2);
        output_data[row_a + 4u * bx + 3u] = pack_y410(a3);
        output_data[row_b + 4u * bx] = pack_y410(b0);
        output_data[row_b + 4u * bx + 1u] = pack_y410(b1);
        output_data[row_b + 4u * bx + 2u] = pack_y410(b2);
        output_data[row_b + 4u * bx + 3u] = pack_y410(b3);
    } else {
        // YUV444P10: 16-bit luma; one UV word per pixel.
        output_data[row_a + 2u * bx] = pack_y10(a0, a1);
        output_data[row_a + 2u * bx + 1u] = pack_y10(a2, a3);
        output_data[row_b + 2u * bx] = pack_y10(b0, b1);
        output_data[row_b + 2u * bx + 1u] = pack_y10(b2, b3);
        uint ca = params.chroma_offset + y0 * params.chroma_pitch + 4u * bx;
        uint cb = ca + params.chroma_pitch;
        output_data[ca] = pack_c10(a0.yz);
        output_data[ca + 1u] = pack_c10(a1.yz);
        output_data[ca + 2u] = pack_c10(a2.yz);
        output_data[ca + 3u] = pack_c10(a3.yz);
        output_data[cb] = pack_c10(b0.yz);
        output_data[cb + 1u] = pack_c10(b1.yz);
        output_data[cb + 2u] = pack_c10(b2.yz);
        output_data[cb + 3u] = pack_c10(b3.yz);
    }
}
