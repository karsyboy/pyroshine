	sha256sums = d5601b7c0c18b261e7fade07afad1a7f98f67628f59d097d2a4171e1a1bfa266

pkgname = pyroshine-bin
	install = pyroshine-bin.install
	depends = glibc>=2.39
	depends = libgcc
	depends = libstdc++
	depends = libdrm
	depends = libevdev
	depends = libffi
	depends = libxkbcommon
	depends = mesa
	depends = opus
	depends = vulkan-icd-loader
	depends = wayland
	depends = xorg-xwayland
	optdepends = vulkan-driver: hardware Vulkan for PyroWave encoding
	optdepends = pyroshine-ui-bin: system tray, pairing and settings app
	provides = pyroshine=0.17.1
	conflicts = pyroshine
	conflicts = moonshine
	conflicts = moonshine-bin

pkgname = pyroshine-ui-bin
	pkgdesc = Desktop app for the Pyroshine streaming server: tray, pairing, clients, settings and stream dashboard
	install = pyroshine-ui-bin.install
	depends = pyroshine=0.17.1
	depends = cairo
	depends = dbus
	depends = gdk-pixbuf2
	depends = glib2
	depends = glibc>=2.39
	depends = gtk3
	depends = hicolor-icon-theme
	depends = libgcc
	depends = libsoup3
	depends = webkit2gtk-4.1
	provides = pyroshine-ui=0.17.1
	conflicts = pyroshine-ui
	backup = etc/xdg/autostart/pyroshine-ui.desktop
