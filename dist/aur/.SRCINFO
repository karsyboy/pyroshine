pkgbase = pyroshine-bin
	pkgdesc = Pyroshine game-streaming host for Moonlight clients, with native PyroWave support
	pkgver = 0.17.1
	pkgrel = 1
	url = https://github.com/karsyboy/pyroshine
	arch = x86_64
	license = BSD-2-Clause
	noextract = pyroshine-0.17.1-nfpm.tar.zst
	noextract = pyroshine-ui-0.17.1-nfpm.tar.zst
	options = !strip
	options = !debug
	source = pyroshine-0.17.1-nfpm.tar.zst::https://github.com/karsyboy/pyroshine/releases/download/v0.17.1/pyroshine-0.17.1-1-x86_64.pkg.tar.zst
