{
  "defaults": {
    "address": "0.0.0.0",
    "application": [
      {
        "boxart": null,
        "command": [
          "/usr/bin/steam",
          "steam://open/bigpicture"
        ],
        "launch_timeout_secs": 2,
        "title": "Steam"
      }
    ],
    "application_scanner": [
      {
        "command": [
          "/usr/bin/steam",
          "-bigpicture",
          "steam://rungameid/{game_id}"
        ],
        "launch_timeout_secs": 2,
        "library": "$HOME/.local/share/Steam",
        "type": "steam"
      }
    ],
    "compositor": {
      "capture_mode": "auto",
      "gpu": null,
      "hdr": true,
      "keyboard": {
        "layout": "us",
        "model": "",
        "options": null,
        "variant": ""
      },
      "steam_mode": true,
      "virtual_connector_strategy": "single_application"
    },
    "inhibit_sleep": true,
    "name": "Pyroshine",
    "stream": {
      "audio": {
        "port": 48000
      },
      "control": {
        "gamepad": {
          "emulation": "auto",
          "home_button": {
            "hold_ms": 0,
            "rumble_duration_ms": 50,
            "rumble_intensity": 0.5,
            "suppress_home": false
          }
        },
        "port": 47999
      },
      "port": 48010,
      "timeout": 60,
      "video": {
        "conversion_queue": "auto",
        "encrypt": false,
        "fec_max_percentage": 25,
        "fec_min_percentage": 0,
        "fec_mode": "fixed",
        "fec_percentage": 20,
        "log_frame_spikes": false,
        "log_stats": true,
        "max_packet_size": 0,
        "port": 47998,
        "pyrowave_queue": "auto"
      }
    },
    "webserver": {
      "certificate": "$HOME/.config/moonshine/cert.pem",
      "enable_pairing": true,
      "port": 47989,
      "port_https": 47984,
      "private_key": "$HOME/.config/moonshine/key.pem"
    }
  },
